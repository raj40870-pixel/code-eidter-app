<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tab_root"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="6dp"
    android:background="#161616"
    android:clickable="true"
    android:focusable="true">

    <!-- Official Real Language Logo (HTML5 shield, JS square, CSS3, Java, etc.) -->
    <ImageView
        android:id="@+id/iv_tab_logo"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_logo_html5" />

    <!-- File Name -->
    <TextView
        android:id="@+id/tv_tab_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="main.cpp"
        android:textColor="#CCCCCC"
        android:textSize="12.5sp"
        android:fontFamily="monospace"
        android:singleLine="true" />

    <!-- Close Tab (✕) Button -->
    <ImageView
        android:id="@+id/btn_tab_close"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:padding="5dp"
        android:src="@drawable/ic_close"
        app:tint="#777777"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close Tab" />

    <!-- Tab Separator Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:background="#262626" />

</LinearLayout>
